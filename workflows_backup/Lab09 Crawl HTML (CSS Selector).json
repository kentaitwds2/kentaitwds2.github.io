{"updatedAt":"2026-08-20T07:27:01.855Z","createdAt":"2026-08-20T07:27:01.855Z","id":"cF7AAxe5xJRcUEsB","name":"Lab09 Crawl HTML (CSS Selector)","active":false,"isArchived":false,"nodes":[{"parameters":{},"type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[0,0],"id":"dfe5043d-4133-4e21-b55d-53fd05a11c66","name":"When clicking ‘Execute workflow’"},{"parameters":{"url":"https://blog.n8n.io/","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[224,0],"id":"b3ec042e-fa0c-41de-a9df-7768a02f682f","name":"HTTP Request"},{"parameters":{"operation":"extractHtmlContent","extractionValues":{"values":[{"key":"blogs","cssSelector":".item-title","returnArray":true}]},"options":{}},"type":"n8n-nodes-base.html","typeVersion":1.2,"position":[448,0],"id":"6c66f9b4-144c-4fc2-9519-501e59854e25","name":"HTML"},{"parameters":{"fieldToSplitOut":"blogs","options":{}},"type":"n8n-nodes-base.splitOut","typeVersion":1,"position":[672,0],"id":"1cbab104-1fd6-4a4d-a18e-a6c5074038f0","name":"Split Out"},{"parameters":{"jsCode":"return $input.all().map(item => {\n  const text = item.json.blogs || '';\n  \n  // Regular expression to find anything inside square brackets at the end of the string\n  const urlMatch = text.match(/\\[(.*?)\\]$/);\n  \n  let url = '';\n  let title = text;\n\n  if (urlMatch) {\n    // Extract the URL from inside the brackets\n    url = urlMatch[1].trim();\n    // Remove the bracketed URL part from the text to leave only the title\n    title = text.replace(urlMatch[0], '').trim();\n  }\n\n  // Combine with the base URL (handling double slashes just in case)\n  const baseUrl = 'https://blog.n8n.io';\n  const cleanUrl = url.startsWith('/') ? url : '/' + url;\n  \n  return {\n    json: {\n      title: title,\n      url: baseUrl + cleanUrl\n    }\n  };\n});"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[896,0],"id":"75606d8e-861a-4ec9-913a-785026e66b6c","name":"Parse Text"},{"parameters":{"operation":"convertToHtmlTable","options":{}},"type":"n8n-nodes-base.html","typeVersion":1.2,"position":[1120,0],"id":"d8dfbef4-c096-4ff1-bf65-79d4aa53d320","name":"HTML1"},{"parameters":{"sendTo":"={{ $vars.EMAIL_MARKETING_MANAGER }}","subject":"n8n.io blogs","message":"={{ $json.table }}","options":{}},"type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[1328,0],"id":"19d03a39-f7ef-4e5f-ad50-41000c4b7864","name":"Send a message","webhookId":"dd214be3-3e69-48d4-a949-0bc8b5b3a87c","credentials":{"gmailOAuth2":{"id":"XJkUzlQBFLPxXP4D","name":"Gmail account"}}}],"connections":{"When clicking ‘Execute workflow’":{"main":[[{"node":"HTTP Request","type":"main","index":0}]]},"HTTP Request":{"main":[[{"node":"HTML","type":"main","index":0}]]},"HTML":{"main":[[{"node":"Split Out","type":"main","index":0}]]},"Split Out":{"main":[[{"node":"Parse Text","type":"main","index":0}]]},"Parse Text":{"main":[[{"node":"HTML1","type":"main","index":0}]]},"HTML1":{"main":[[{"node":"Send a message","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","binaryMode":"separate"},"staticData":null,"meta":{"templateCredsSetupCompleted":true,"instanceId":"a9d452d0e89ccea9e07b9c3aa52ccf4eb717e6cdaafd757f9e5d705912795eb2"},"nodeGroups":[],"pinData":{},"versionId":"86396d5b-dea7-4eaf-9321-16f49ba97325","activeVersionId":null,"triggerCount":0,"tags":[],"shared":[{"updatedAt":"2026-08-20T07:27:01.856Z","createdAt":"2026-08-20T07:27:01.856Z","role":"workflow:owner","workflowId":"cF7AAxe5xJRcUEsB","projectId":"6OeHKkGCqFX6qpKa"}],"activeVersion":null}